{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn: test",
            "type": "shell",
            "command": "mvn test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "mvn: test + coverage",
            "type": "shell",
            "command": "mvn test && start target\\site\\jacoco\\index.html",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "mvn: compile",
            "type": "shell",
            "command": "mvn compile && Copy-Item src/application/Main.fxml target/classes/application/Main.fxml -Force",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
