<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane minHeight="700.0" minWidth="1100.0" onDragDropped="#logFileDrop" onDragOver="#dragOver" prefHeight="750.0" prefWidth="1200.0" styleClass="root" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.MainController">
   <!-- Top Header -->
   <top>
      <VBox styleClass="header">
         <padding>
            <Insets top="15" right="20" bottom="15" left="20" />
         </padding>

         <!-- Configuration Row -->
         <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="SOMETIMES">
               <Label text="Categoria" styleClass="header-label" />
               <TextField fx:id="categoryTextField" promptText="Digite a categoria..." styleClass="modern-text-field" prefWidth="300"/>
            </VBox>

            <VBox spacing="5" HBox.hgrow="SOMETIMES">
               <Label text="Circuito" styleClass="header-label" />
               <TextField fx:id="circuitTextField" promptText="Digite o circuito..." styleClass="modern-text-field" prefWidth="300"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT">
               <Label text="Opções" styleClass="header-label" />
               <HBox spacing="15">
                  <CheckBox fx:id="hardDnfCheckBox" text="DNF Rígido" styleClass="header-checkbox" />
                  <CheckBox fx:id="selectiveCheckBox" text="Seletiva" styleClass="header-checkbox" />
               </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <VBox spacing="5" alignment="TOP_RIGHT">
               <Label text="Pilotos Carregados" styleClass="header-label" />
               <Text fx:id="textDrivers" onMouseEntered="#showDrivers" onMouseExited="#hideDrivers"
                     styleClass="driver-counter" text="0 Pilotos" textAlignment="CENTER" />
            </VBox>
         </HBox>

         <!-- Action Buttons Row -->
         <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
            <!-- Main Actions -->
            <Button onAction="#processLogFileChooser" text="Importar Log" styleClass="btn-primary-large" prefWidth="160" />
            <Button onAction="#readEventFileChooser" text="Importar Evento" styleClass="btn-secondary-action" prefWidth="140" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Utility Actions - Minimal style -->
            <Button onAction="#readCsvFileChooser" text="Pilotos..." styleClass="btn-minimal" prefWidth="75" />
            <Button onAction="#clearDrivers" text="Limpar" styleClass="btn-minimal" prefWidth="65" />
            <Button onAction="#clear" text="Resetar" styleClass="btn-minimal-warning" prefWidth="70" />
         </HBox>
      </VBox>
   </top>

   <!-- Main Content Area -->
   <center>
      <StackPane>
         <!-- Welcome Screen (shown when no data loaded) -->
         <VBox fx:id="welcomeScreen" alignment="CENTER" spacing="30" styleClass="welcome-screen" style="-fx-padding: 40 20;">
            <Label text="Race Results" styleClass="welcome-title-simple" />

            <!-- Unified Drop Zone -->
            <VBox spacing="25" alignment="CENTER" styleClass="drop-zone-unified" prefWidth="600" maxWidth="700" prefHeight="340">
               <Label text="Arraste os arquivos para começar" styleClass="drop-zone-main-title" />

               <VBox spacing="20" alignment="CENTER">
                  <!-- Instruction 1 - Pilotos -->
                  <HBox spacing="15" alignment="CENTER_LEFT" styleClass="drop-instruction">
                     <Label text="1" styleClass="drop-number" />
                     <VBox spacing="3">
                        <Label text="Arquivo de pilotos (opcional)" styleClass="drop-instruction-title" />
                        <Label text="CSV com lista de pilotos" styleClass="drop-instruction-hint" />
                     </VBox>
                  </HBox>

                  <Separator prefWidth="500" />

                  <!-- Instruction 2 - Log -->
                  <HBox spacing="15" alignment="CENTER_LEFT" styleClass="drop-instruction-primary">
                     <Label text="2" styleClass="drop-number-primary" />
                     <VBox spacing="3">
                        <Label text="Log da corrida (obrigatório)" styleClass="drop-instruction-title-primary" />
                        <Label text="JSON, XML ou CSV do simulador" styleClass="drop-instruction-hint-primary" />
                     </VBox>
                  </HBox>
               </VBox>

               <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15 0 0 0;">
                  <Label text="↓" styleClass="drop-zone-arrow-unified" />
                  <Label text="Arraste aqui" styleClass="drop-zone-cta" />
               </VBox>
            </VBox>

            <Label text="Ou use o botão 'Importar Log' acima" styleClass="welcome-footer-hint" />
         </VBox>

         <!-- Results Panel (shown when data is loaded) -->
         <HBox fx:id="resultsPanel" spacing="15" style="-fx-padding: 20;" visible="false" managed="false">
            <!-- Left Panel - Qualify -->
            <VBox spacing="10" styleClass="panel" prefWidth="450" minWidth="400" HBox.hgrow="SOMETIMES">
               <Label text="QUALIFICAÇÃO" styleClass="panel-title" />
               <Separator />
               <TextArea fx:id="qualifyTextArea" VBox.vgrow="ALWAYS" styleClass="code-area" wrapText="false" />
            </VBox>

            <!-- Right Panel - Race Results -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel" minWidth="600">
            <Label text="CORRIDA" styleClass="panel-title" />
            <Separator />
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="modern-tabs">
               <Tab text="Log">
                  <TextArea fx:id="raceTextArea" styleClass="code-area" wrapText="false" />
               </Tab>
               <Tab text="Tabela">
                  <HBox spacing="15" style="-fx-padding: 10;">
                     <!-- Left side - Control Buttons -->
                     <VBox spacing="10" alignment="TOP_CENTER" styleClass="panel-controls" prefWidth="140" minWidth="140" maxWidth="140" style="-fx-padding: 40 0 0 0;">
                        <Label text="CONTROLES" styleClass="panel-title-small" />
                        <Separator prefWidth="110" />

                        <Button onAction="#moveUpButton" text="↑ Subir" maxWidth="Infinity" styleClass="btn-success" />
                        <Button onAction="#moveDownButton" text="↓ Descer" maxWidth="Infinity" styleClass="btn-orange" />
                        <Button onAction="#lastPositionButton" text="↓↓ Última Pos" maxWidth="Infinity" styleClass="btn-deep-orange" />

                        <Separator prefWidth="110" />

                        <Button onAction="#didNotFinishedButton" text="DNF" maxWidth="Infinity" styleClass="btn-danger" />
                        <Button onAction="#disqualifyButton" text="DQ" maxWidth="Infinity" styleClass="btn-dark-red" />

                        <Separator prefWidth="110" />

                        <Button onAction="#resetRace" text="Reset" maxWidth="Infinity" styleClass="btn-primary" />
                     </VBox>

                     <!-- Right side - Table -->
                     <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                           <Label text="Bateria:" styleClass="label-bold" />
                           <ComboBox fx:id="batteryComboBox" prefWidth="150" styleClass="modern-combo" />
                        </HBox>
                        <TableView fx:id="raceTableView" VBox.vgrow="ALWAYS" styleClass="modern-table">
                           <columns>
                              <TableColumn fx:id="positionColumn" text="Pos" minWidth="50" prefWidth="55" />
                              <TableColumn fx:id="driverColumn" text="Piloto" minWidth="120" prefWidth="150" />
                              <TableColumn fx:id="textColumn" text="Informações" minWidth="200" />
                           </columns>
                        </TableView>
                     </VBox>
                  </HBox>
               </Tab>
               <Tab text="Licença">
                  <TextArea fx:id="licenseTextArea" onKeyReleased="#updateLicensePoints"
                           styleClass="code-area" promptText="Digite os pontos de licença no formato: Nome +10" />
               </Tab>
               <Tab text="Sheets">
                  <TextArea fx:id="sheetsTextArea" styleClass="code-area" wrapText="false" />
               </Tab>
               <Tab text="Sheets IR">
                  <TextArea fx:id="sheetsResultsTextArea" styleClass="code-area" wrapText="false" />
               </Tab>
            </TabPane>
         </VBox>
         </HBox>
      </StackPane>
   </center>

   <!-- Bottom Footer -->
   <bottom>
      <HBox alignment="CENTER" spacing="20" styleClass="footer">
         <Text fx:id="versaoLabel" text="v6.5" styleClass="version-text" />
         <Region HBox.hgrow="ALWAYS" />
         <Text text="Made by Rodrigo de Sousa" styleClass="footer-text" />
      </HBox>
   </bottom>
</BorderPane>

